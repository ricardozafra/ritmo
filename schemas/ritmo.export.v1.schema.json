{
  "title": "Ritmo export envelope v1",
  "description": "JSON Schema 2020-12; contrato puro, sem bytes de áudio embutidos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "business_timezone",
    "settings",
    "days",
    "holidays",
    "protocol_alarms",
    "cycles",
    "mentorships",
    "contacts",
    "weekly_reviews",
    "manifest",
    "change_initiatives",
    "audio_assets",
    "notification_plans",
    "metrics_snapshot"
  ],
  "properties": {
    "schema": { "const": "ritmo.export" },
    "schema_version": { "const": 1 },
    "generated_at": { "$ref": "#/$defs/official_instant" },
    "business_timezone": { "const": "America/Sao_Paulo" },
    "settings": { "$ref": "#/$defs/settings" },
    "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
    "holidays": { "type": "array", "items": { "$ref": "#/$defs/holiday" } },
    "protocol_alarms": { "type": "array", "items": { "$ref": "#/$defs/protocol_alarm" } },
    "cycles": { "type": "array", "items": { "$ref": "#/$defs/cycle" } },
    "mentorships": { "type": "array", "items": { "$ref": "#/$defs/mentorship" } },
    "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
    "weekly_reviews": { "type": "array", "items": { "$ref": "#/$defs/weekly_review" } },
    "manifest": { "$ref": "#/$defs/manifest" },
    "change_initiatives": { "type": "array", "items": { "$ref": "#/$defs/change_initiative" } },
    "audio_assets": { "type": "array", "items": { "$ref": "#/$defs/audio_asset" } },
    "notification_plans": { "type": "array", "items": { "$ref": "#/$defs/notification_plan" } },
    "metrics_snapshot": { "$ref": "#/$defs/metrics_snapshot" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1 },
    "operational_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "official_instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?-0[23]:00$"
    },
    "civil_time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "nullable_string": { "type": ["string", "null"] },
    "nullable_identifier": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
    "nullable_date": { "anyOf": [{ "$ref": "#/$defs/operational_date" }, { "type": "null" }] },
    "nullable_instant": { "anyOf": [{ "$ref": "#/$defs/official_instant" }, { "type": "null" }] },
    "audio_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "relative_path": { "type": "string", "pattern": "^audio/[^\\\\]+$" }
      }
    },
    "nullable_audio_ref": { "anyOf": [{ "$ref": "#/$defs/audio_ref" }, { "type": "null" }] },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_date", "day_close_time", "night_end_time", "review", "sync_enabled"],
      "properties": {
        "activation_date": { "$ref": "#/$defs/nullable_date" },
        "day_close_time": { "$ref": "#/$defs/civil_time" },
        "night_end_time": { "$ref": "#/$defs/civil_time" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekday", "time", "sunday_notification_enabled"],
          "properties": {
            "weekday": { "enum": ["sunday", "monday"] },
            "time": { "$ref": "#/$defs/civil_time" },
            "sunday_notification_enabled": { "type": "boolean" }
          }
        },
        "sync_enabled": { "const": false }
      }
    },
    "day_derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_workday", "counts_in_metrics"],
      "properties": {
        "is_workday": { "type": "boolean" },
        "counts_in_metrics": { "type": "boolean" }
      }
    },
    "pillar_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operational_date", "pillar", "workout_done", "briefing_done",
        "briefing_mode", "workout_at", "briefing_at", "toggle_on",
        "change_initiative_id", "note_text", "note_audio_ref",
        "night_kind", "recovery_note", "study_block_id"
      ],
      "properties": {
        "operational_date": { "$ref": "#/$defs/operational_date" },
        "pillar": { "enum": ["morning", "day", "night"] },
        "workout_done": { "type": "boolean" },
        "briefing_done": { "type": "boolean" },
        "briefing_mode": { "type": ["string", "null"], "enum": ["automatic", "manual", null] },
        "workout_at": { "$ref": "#/$defs/nullable_instant" },
        "briefing_at": { "$ref": "#/$defs/nullable_instant" },
        "toggle_on": { "type": "boolean" },
        "change_initiative_id": { "$ref": "#/$defs/nullable_identifier" },
        "note_text": { "type": ["string", "null"], "maxLength": 500 },
        "note_audio_ref": { "$ref": "#/$defs/nullable_audio_ref" },
        "night_kind": { "type": ["string", "null"], "enum": ["study", "recovery", null] },
        "recovery_note": { "type": ["string", "null"], "maxLength": 500 },
        "study_block_id": { "$ref": "#/$defs/nullable_identifier" }
      }
    },
    "study_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operational_date", "started_at", "block_deadline", "ended_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "operational_date": { "$ref": "#/$defs/operational_date" },
        "started_at": { "$ref": "#/$defs/official_instant" },
        "block_deadline": { "$ref": "#/$defs/official_instant" },
        "ended_at": { "$ref": "#/$defs/nullable_instant" }
      }
    },
    "pillar_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operational_date", "pillar", "reason_text", "recurrence_confirmed", "revoked_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "operational_date": { "$ref": "#/$defs/operational_date" },
        "pillar": { "enum": ["morning", "day", "night"] },
        "reason_text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recurrence_confirmed": { "type": "boolean" },
        "revoked_at": { "$ref": "#/$defs/nullable_instant" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operational_date", "base_result", "effective_result", "mute_cause",
        "previous_result", "closed_at", "seal_timestamp", "derived",
        "pillar_entries", "study_blocks", "pillar_waivers"
      ],
      "properties": {
        "operational_date": { "$ref": "#/$defs/operational_date" },
        "base_result": { "enum": ["sealed", "unsealed"] },
        "effective_result": { "enum": ["sealed", "unsealed", "mute"] },
        "mute_cause": { "type": ["string", "null"], "enum": ["weekend", "holiday", null] },
        "previous_result": { "type": ["string", "null"], "enum": ["sealed", "unsealed", null] },
        "closed_at": { "$ref": "#/$defs/nullable_instant" },
        "seal_timestamp": { "$ref": "#/$defs/nullable_instant" },
        "derived": { "$ref": "#/$defs/day_derived" },
        "pillar_entries": { "type": "array", "items": { "$ref": "#/$defs/pillar_entry" } },
        "study_blocks": { "type": "array", "items": { "$ref": "#/$defs/study_block" } },
        "pillar_waivers": { "type": "array", "items": { "$ref": "#/$defs/pillar_waiver" } }
      }
    },
    "holiday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operational_date", "active", "created_at", "removed_at", "apply_reason_text", "remove_reason_text"],
      "properties": {
        "operational_date": { "$ref": "#/$defs/operational_date" },
        "active": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/official_instant" },
        "removed_at": { "$ref": "#/$defs/nullable_instant" },
        "apply_reason_text": { "type": ["string", "null"], "maxLength": 500 },
        "remove_reason_text": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "protocol_alarm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "generation_id", "start_date", "end_date", "sequence_length",
        "state", "previous_state", "triggered_at", "cause",
        "plan_or_execution", "adjustment"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "generation_id": { "$ref": "#/$defs/identifier" },
        "start_date": { "$ref": "#/$defs/operational_date" },
        "end_date": { "$ref": "#/$defs/operational_date" },
        "sequence_length": { "type": "integer", "minimum": 2 },
        "state": { "enum": ["pending", "answered", "invalidated"] },
        "previous_state": { "type": ["string", "null"], "enum": ["pending", "answered", null] },
        "triggered_at": { "$ref": "#/$defs/nullable_instant" },
        "cause": { "type": ["string", "null"], "maxLength": 2000 },
        "plan_or_execution": { "type": ["string", "null"], "enum": ["plan", "execution", null] },
        "adjustment": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "checkpoint_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkpoint_id", "weekly_review_id", "gartner_level", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "checkpoint_id": { "$ref": "#/$defs/identifier" },
        "weekly_review_id": { "$ref": "#/$defs/nullable_identifier" },
        "gartner_level": { "enum": ["BD", "B", "I", "A", "E"] },
        "notes": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cycle_id", "competency", "date", "status", "checkpoint_evals"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "cycle_id": { "$ref": "#/$defs/identifier" },
        "competency": { "enum": ["ST", "IN", "CA"] },
        "date": { "$ref": "#/$defs/operational_date" },
        "status": { "type": "string", "minLength": 1 },
        "checkpoint_evals": { "type": "array", "items": { "$ref": "#/$defs/checkpoint_eval" } }
      }
    },
    "cycle_closure_invite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle_id", "week_start"],
      "properties": {
        "cycle_id": { "$ref": "#/$defs/identifier" },
        "week_start": { "$ref": "#/$defs/operational_date" }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "purpose_text", "start_date", "end_date", "state",
        "derived", "checkpoints", "cycle_closure_invites"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "maxLength": 120 },
        "purpose_text": { "type": "string", "maxLength": 1000 },
        "start_date": { "$ref": "#/$defs/operational_date" },
        "end_date": { "$ref": "#/$defs/operational_date" },
        "state": { "enum": ["active", "archived"] },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": ["awaiting_closure"],
          "properties": { "awaiting_closure": { "type": "boolean" } }
        },
        "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
        "cycle_closure_invites": { "type": "array", "items": { "$ref": "#/$defs/cycle_closure_invite" } }
      }
    },
    "mentorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "competency", "mentor_name", "last_meeting_date"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "competency": { "enum": ["ST", "IN", "CA"] },
        "mentor_name": { "type": ["string", "null"], "maxLength": 120 },
        "last_meeting_date": { "$ref": "#/$defs/nullable_date" }
      }
    },
    "weekly_contact_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week_start", "contact_id", "status", "created_at"],
      "properties": {
        "week_start": { "$ref": "#/$defs/operational_date" },
        "contact_id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["pending", "done", "skipped"] },
        "created_at": { "$ref": "#/$defs/official_instant" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "context_note", "last_touch_date", "created_at", "weekly_contact_suggestions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "maxLength": 120 },
        "context_note": { "type": ["string", "null"], "maxLength": 500 },
        "last_touch_date": { "$ref": "#/$defs/nullable_date" },
        "created_at": { "$ref": "#/$defs/official_instant" },
        "weekly_contact_suggestions": { "type": "array", "items": { "$ref": "#/$defs/weekly_contact_suggestion" } }
      }
    },
    "weekly_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "week_start", "answer_fulfilled", "answer_failed",
        "answer_lesson", "audio_ref", "state", "created_at",
        "autosaved_at", "finalized_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "week_start": { "$ref": "#/$defs/operational_date" },
        "answer_fulfilled": { "type": ["string", "null"], "maxLength": 5000 },
        "answer_failed": { "type": ["string", "null"], "maxLength": 5000 },
        "answer_lesson": { "type": ["string", "null"], "maxLength": 5000 },
        "audio_ref": { "$ref": "#/$defs/nullable_audio_ref" },
        "state": { "enum": ["draft", "finalized"] },
        "created_at": { "$ref": "#/$defs/official_instant" },
        "autosaved_at": { "$ref": "#/$defs/nullable_instant" },
        "finalized_at": { "$ref": "#/$defs/nullable_instant" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_version", "first_copied_at", "last_edited_at", "content_markdown"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "asset_version": { "type": "string" },
        "first_copied_at": { "$ref": "#/$defs/official_instant" },
        "last_edited_at": { "$ref": "#/$defs/nullable_instant" },
        "content_markdown": { "type": "string" }
      }
    },
    "change_initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "maxLength": 120 },
        "active": { "type": "boolean" }
      }
    },
    "audio_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path", "kind", "duration_ms", "byte_size", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "relative_path": { "type": "string", "pattern": "^audio/[^\\\\]+$" },
        "kind": { "enum": ["day_note", "weekly_review"] },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "created_at": { "$ref": "#/$defs/official_instant" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "day_note" } } },
          "then": { "properties": { "duration_ms": { "maximum": 300000 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "weekly_review" } } },
          "then": { "properties": { "duration_ms": { "maximum": 1800000 } } }
        }
      ]
    },
    "notification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "kind", "planned_at", "state"],
      "properties": {
        "idempotency_key": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["weekly_review_sunday", "weekly_review_monday"] },
        "planned_at": { "$ref": "#/$defs/official_instant" },
        "state": { "enum": ["planned", "delivered", "cancelled", "suppressed"] }
      }
    },
    "metrics_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
